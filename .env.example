## ---------------------------------------------------------------------------
## Resource Booking — environment configuration
## Copy to .env and fill in the blanks: `cp .env.example .env`
## ---------------------------------------------------------------------------

APP_NAME="Resource Booking"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://resource-booking.example.edu.au
APP_TIMEZONE=Australia/Brisbane
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

## Database — pgsql (default) or mysql/mariadb.
## DB_HOST must be the `db` service's container_name (from docker-compose.yml),
## not the bare service name "db" — on a shared external Docker network with
## other stacks, a generic "db" DNS alias can collide with another project's
## database container of the same service name.
DB_CONNECTION=pgsql
DB_HOST=resource-booking-db
DB_PORT=5432
DB_DATABASE=resource_booking
DB_USERNAME=resource_booking
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
## lax is right for a standalone deployment. If you enable iframe embedding
## (Administration -> Settings -> Embedding) the app promotes the cookie to
## SameSite=None; Secure automatically — only set this to "none" explicitly if
## you want that regardless of the embedding toggle. "none" REQUIRES HTTPS.
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

## ---------------------------------------------------------------------------
## Mail
## ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
## Set to false only for an anonymous/no-auth relay that can't complete a
## STARTTLS handshake (e.g. behind a TLS-inspecting firewall) — see
## config/mail.php. Leave true for anything else.
MAIL_SMTP_AUTO_TLS=true

## Non-secret notification addresses (also editable under Administration -> Settings)
IT_NOTIFICATION_ADDRESS=
HELPDESK_REPLY_TO_ADDRESS=

## ---------------------------------------------------------------------------
## Authentication — OpenID Connect (generic; tested against Microsoft Entra ID)
## ---------------------------------------------------------------------------
OIDC_ENABLED=true
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=${APP_URL}/auth/callback
## Comma-separated list of email domains allowed to authenticate. Empty = no restriction.
OIDC_ALLOWED_DOMAINS=

## Emergency break-glass admin login (bypasses OIDC). Off by default — even
## when true, an account also needs a password set via
## `php artisan admin:set-local-password {email}` (CLI only, never self-service)
## and must hold the administrator role.
LOCAL_LOGIN_ENABLED=false

## ---------------------------------------------------------------------------
## Snipe-IT integration (optional — the app functions without it)
## ---------------------------------------------------------------------------
SNIPEIT_ENABLED=true
SNIPEIT_URL=
SNIPEIT_API_TOKEN=

## ---------------------------------------------------------------------------
## Booking defaults — most of these are also editable under Administration -> Settings
## once the application is running; these env values only seed the initial settings.
## ---------------------------------------------------------------------------
BOOKING_MIN_AUTO_APPROVAL_LEAD_HOURS=6
BOOKING_SCHOOL_DAY_START=07:00
BOOKING_SCHOOL_DAY_FINISH=17:00
BOOKING_ALLOW_WEEKENDS=false
BOOKING_REFERENCE_PREFIX=EX

## Iframe embedding. Off by default (the app can only frame itself). These just
## seed the initial values — the real switch is Administration -> Settings ->
## Embedding. List parent origins one per line or comma-separated, scheme+host.
BOOKING_EMBEDDING_ENABLED=false
BOOKING_EMBEDDING_ALLOWED_ORIGINS=

## Comma-separated local application email addresses to seed as Administrators
## before their first OIDC login (local-part only is fine if it matches OIDC email).
ADMIN_SEED_EMAILS=
